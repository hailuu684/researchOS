# Copy this file to .env and fill in your real Modal credentials.
# Never commit .env.

MODAL_LLM_BASE_URL=https://hysonlab-weather-forecast--ep-gemma-4-e4b-it-server.us-west.modal.direct/v1
MODAL_LLM_MODEL=google/gemma-4-E4B-it
MODAL_LLM_API_KEY=unused

# Required for Modal protected endpoints
MODAL_KEY=wk-your_key
MODAL_SECRET=ws-your_key

# Generation defaults
MODAL_LLM_REASONING=true
MODAL_LLM_MAX_TOKENS=4096
MODAL_LLM_TEMPERATURE=0.2
MODAL_LLM_TOP_P=0.9
MODAL_LLM_TIMEOUT=180

# Backend server defaults
RESEARCHOS_STATE_DIR=outputs/state
RESEARCHOS_DEFAULT_USE_LLM=true
RESEARCHOS_FALLBACK_ON_LLM_ERROR=true

HF_AUTH=your_key
LOCAL_LLM_MODEL_VLLM=Qwen/Qwen2.5-32B-Instruct:featherless-ai
LOCAL_LLM_MODEL=Qwen/Qwen2.5-32B-Instruct
LOCAL_LLM_MAX_TOKENS=2048
LOCAL_LLM_TEMPERATURE=0.2

# Scholar API/ https://github.com/jonatasgrosman/findpapers
IEEE_KEY=your_key # Metadata Search
SEMANTIC_SCHOLAR_KEY=s2k-your_key
